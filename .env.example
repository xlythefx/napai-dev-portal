# RAG PHP API base URL (Wampserver)
# Default: http://localhost/napai-api
VITE_RAG_API_URL=http://localhost/napai-api

# Fal AI (TikTok Affiliate): Add key in napai-api/config/fal_key.php

# Shotstack (video stitch): Set env or napai-api/config/shotstack_key.php
# SHOTSTACK_API_KEY=your_key
# SHOTSTACK_OWNER_ID=optional

# Cloudinary (final video hosting): Set env vars or napai-api/config/cloudinary_key.php
# CLOUDINARY_CLOUD_NAME=your_cloud
# CLOUDINARY_API_KEY=648694459315237
# CLOUDINARY_API_SECRET=your_secret
